# Copy to .env.local and fill with your Supabase project values.
# The app requires valid Supabase configuration at boot — there is no demo mode.

# ---------------------------------------------------------------------------
# Frontend (Vite) — required client-safe variables
# ---------------------------------------------------------------------------
VITE_SUPABASE_URL=https://your-project.supabase.co
VITE_SUPABASE_ANON_KEY=your-anon-key

# Optional client-side model routing (safe: model names only; no secrets):
# Default (if unset):
#   VITE_AI_MODEL=gemini-2.5-flash   # must match the VERTEX_AI_MODEL_ID secret
# VITE_DEBUG_ONBOARDING=true

# Optional — Google Search Console integration (Phase D). Client ID + redirect
# are public; the client secret is a server-side edge secret (see below). Leave
# unset to hide the "Connect Search Console" action in the SEO module.
# VITE_GOOGLE_OAUTH_CLIENT_ID=your-oauth-client-id.apps.googleusercontent.com
# VITE_GOOGLE_OAUTH_REDIRECT_URI=http://localhost:5174/integrations/google/callback

# ---------------------------------------------------------------------------
# Frontend (Vite) — forbidden secret variables (DO NOT set in .env.local)
# ---------------------------------------------------------------------------
# VITE_SUPABASE_SERVICE_ROLE_KEY=
# VITE_VERTEX_SERVICE_ACCOUNT=

# ---------------------------------------------------------------------------
# Server-side only (Supabase Edge Function secrets, not Vite vars)
# ---------------------------------------------------------------------------
# Vertex AI credentials (required for ai-proxy):
#   supabase secrets set VERTEX_SERVICE_ACCOUNT="$(cat sa.json)"   # raw JSON or base64 JSON
#   supabase secrets set VERTEX_AI_LOCATION=us-central1
#   supabase secrets set VERTEX_AI_MODEL_ID=gemini-2.5-flash
#
# Optional origin/reference metadata for ai-proxy:
#   supabase secrets set APP_URL=https://your-production-origin
#   supabase secrets set ALLOWED_ORIGINS=https://app.example.com,https://staging.example.com
#
# Google Search Console connector (required for the search-console edge function):
#   supabase secrets set GSC_CLIENT_ID=your-oauth-client-id.apps.googleusercontent.com
#   supabase secrets set GSC_CLIENT_SECRET=your-oauth-client-secret
#   supabase secrets set GSC_REDIRECT_URI=https://your-origin/integrations/google/callback
#   (then: supabase functions deploy search-console)
# The edge functions read SUPABASE_SERVICE_ROLE_KEY, which Supabase auto-injects —
# no need to set a service-role secret yourself.
#
# API-key connectors (HubSpot, etc.) via the connector-proxy function need NO
# platform secret — users paste their own key in the UI:
#   supabase functions deploy connector-proxy
#
# SEO/AEO platform vendor keys (OPTIONAL — all features degrade to an honest state
# when unset; add a key later to light the feature up, no code change). The
# connector-proxy `capabilities` action reports which of these are set (booleans
# only, never the value) to the capability-gating layer (src/lib/capabilities.js):
#   # Real keyword volume & difficulty (WS1c) — DataForSEO uses Basic auth:
#   supabase secrets set DATAFORSEO_LOGIN=your-login
#   supabase secrets set DATAFORSEO_PASSWORD=your-password
#   # AI-visibility surfaces (WS6) — add any one to enable; Perplexity recommended first:
#   supabase secrets set PERPLEXITY_API_KEY=your-key
#   supabase secrets set OPENAI_API_KEY=your-key
#   supabase secrets set ANTHROPIC_API_KEY=your-key
#   # Google AI Overviews scraping + durable mention finder (WS4/WS6):
#   supabase secrets set APIFY_TOKEN=your-token
#   # Page teardown (WS1d) works on Jina's free tier with NO key; a key raises limits:
#   supabase secrets set JINA_API_KEY=your-key   # optional
#
# Dev note: localhost / 127.0.0.1 are allowed dynamically by ai-proxy CORS.
#
# LOCAL TESTING ONLY (never set in production / hosted env):
#   ALLOW_LOCAL_UNAUTH=true   # lets tokenless local curl reach the Vertex path
#   AI_PROXY_DEBUG=true       # extra structured request-path logs (no secrets)

# Database setup (Supabase SQL editor or CLI):
#   1. supabase/migrations/001_core_schema.sql
#   2. supabase/migrations/002_rls_hardening.sql
#
# See docs/security-baseline.md for production checklist.
