# Logs
logs
*.log
npm-debug.log*
yarn-debug.log*
yarn-error.log*
pnpm-debug.log*
lerna-debug.log*

node_modules
dist
dist-demo
dist-ssr
*.local

# Environment files — never commit secrets (.env.example is tracked)
.env
.env.*
!.env.example

# Supabase local secrets — never commit
supabase/.env.local

# Supabase CLI local state — ephemeral, must not be version-controlled
# (churns on every CLI command; lives under supabase/** so it would otherwise
# spuriously trigger the staging-backend deploy workflow)
supabase/.temp/
supabase/.branches/

# Stray Next.js prototype — not part of the KEPLER OS Vite app, excluded from deploy
kepler-os-dashboard/

# Editor directories and files
.vscode/*
!.vscode/extensions.json
.idea
.DS_Store
*.suo
*.ntvs*
*.njsproj
*.sln
*.sw?

# Generated knowledge-graph output (graphify skill) — rebuildable, ~5MB
graphify-out/
